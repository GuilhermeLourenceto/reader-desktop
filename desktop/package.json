{
  "name": "lnreader-desktop",
  "version": "0.4.5",
  "private": true,
  "description": "Reader Desktop for Windows and Linux",
  "author": "LNReader contributors",
  "homepage": "https://github.com/GuilhermeLourenceto/lnreader-desktop",
  "desktopName": "lnreader-desktop",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "build": "node build.mjs",
    "start": "npm run setup && npm run build && electron .",
    "test:smoke": "electron test/smoke.cjs --visual-preview",
    "test:pagination": "electron test/pagination-smoke.cjs --visual-preview",
    "test:reader": "electron test/reader-rules-smoke.cjs --visual-preview",
    "test:visual": "electron test/visual-smoke.cjs --visual-preview",
    "test": "node --test test/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "lint": "node scripts/check-code.cjs",
    "format": "prettier --write src/ test/ scripts/ tools/",
    "format:check": "prettier --check src/Icon.jsx src/SourceFilters.jsx src/DesktopErrorBoundary.jsx src/libraryState.js src/sourceRuntime.js",
    "check": "npm run lint && npm run format:check && npm test",
    "test:journeys": "node test/user-journeys.cjs",
    "test:all": "npm run check && npm run test:smoke && npm run test:pagination && npm run test:reader && npm run test:visual && npm run test:journeys"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "adm-zip": "^0.5.16",
    "buffer": "^6.0.3",
    "cheerio": "1.0.0-rc.12",
    "dayjs": "^1.11.21",
    "htmlparser2": "^12.0.0",
    "lodash-es": "^4.18.1",
    "protobufjs": "^8.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.17.6",
    "urlencode": "^2.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "app.lnreader.desktop",
    "productName": "Reader Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "perMachine": true,
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon-256.png",
      "syncDesktopName": true,
      "maintainer": "Reader Desktop <191923327+GuilhermeLourenceto@users.noreply.github.com>",
      "synopsis": "Leitor de novels com fontes e leitura offline"
    }
  }
}
